PROJECT_NAME="Premium AI Portfolio API"
API_V1_STR="/api/v1"
ENVIRONMENT="production"

# CORS — comma-separated list of allowed origins
# Example: https://your-site.vercel.app,https://www.your-domain.com
BACKEND_CORS_ORIGINS=https://your-frontend.vercel.app

# Security — generate with: openssl rand -hex 32
SECRET_KEY=REPLACE_WITH_A_SUPER_SECRET_KEY_IN_PRODUCTION
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@cluster0.xxxxx.mongodb.net/?appName=Cluster0
DATABASE_NAME=portfolio_db

# Cloudinary (video hosting)
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# SMTP (Gmail — use an App Password, NOT your real password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=Portfolio

# Where contact form submissions are forwarded
NOTIFICATION_EMAIL=your-email@gmail.com
